---
import '@fontsource-variable/jost';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/dm-mono/400.css';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { locales, ogLocales, defaultLocale, isLocale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path = '', jsonLd = [] } = Astro.props;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const canonical = getAbsoluteLocaleUrl(locale, path);
const alternates = locales.map((l) => ({ hreflang: l, href: getAbsoluteLocaleUrl(l, path) }));
// La racine choisit la langue du visiteur (functions/index.ts) : c'est elle, le x-default de la landing.
const xDefault = path ? getAbsoluteLocaleUrl('en', path) : new URL('/', Astro.site).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1B2638" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ilipro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
    <meta name="twitter:card" content="summary" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
