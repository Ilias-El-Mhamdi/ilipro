---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import logo from '../../assets/logo-horizontal.png';
import { locales, localeNames, type Dictionary, type Locale } from '../../i18n/ui';

interface Props {
  t: Dictionary;
  locale: Locale;
  path?: string;
}

const { t, locale, path = '' } = Astro.props;
---

<header class="nav">
  <div class="container nav__inner">
    <a href={getRelativeLocaleUrl(locale)} class="nav__brand">
      <Image src={logo} alt="ilipro" height={36} densities={[1, 2]} loading="eager" />
    </a>
    <nav class="nav__links" aria-label={t.nav.mainLabel}>
      <a href="#cases">{t.nav.cases}</a>
      <a href="#process">{t.nav.process}</a>
      <a href="#model">{t.nav.model}</a>
    </nav>
    <div class="nav__actions">
      <ul class="nav__lang mono" aria-label={t.nav.switchLabel}>
        {
          locales.map((l) => (
            <li>
              {l === locale ? (
                <span aria-current="true">{localeNames[l]}</span>
              ) : (
                <a href={getRelativeLocaleUrl(l, path)} hreflang={l} lang={l}>
                  {localeNames[l]}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <a href="#contact" class="btn btn--primary nav__cta">→ {t.nav.cta}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px dashed var(--line);
  }
  /* Verre dépoli : le contenu défile flouté sous le menu. Repli opaque sans backdrop-filter. */
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav {
      background: color-mix(in srgb, var(--bg) 25%, transparent);
      -webkit-backdrop-filter: blur(16px) saturate(190%);
      backdrop-filter: blur(16px) saturate(190%);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.55);
    }
  }
  .nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: 20px;
  }
  .nav__brand img {
    display: block;
    height: 36px;
    width: auto;
  }
  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-size: 15px;
  }
  /* Survol réservé aux vrais pointeurs : sur mobile, le tap laisserait le lien coloré. */
  @media (hover: hover) {
    .nav__links a:hover {
      color: var(--accent);
    }
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav__lang {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: var(--muted);
  }
  .nav__lang span {
    color: var(--ink);
  }
  .nav__lang a {
    color: var(--accent);
  }
  .nav__cta {
    font-size: 12px;
    padding: 12px 18px;
  }
  /* Mobile : deux lignes — logo + CTA, puis les ancres avec FR/EN à leur droite. */
  @media (max-width: 860px) {
    .nav__inner {
      gap: 10px 12px;
      padding-block: 12px;
    }
    .nav__brand img {
      height: 28px;
    }
    .nav__actions {
      display: contents;
    }
    .nav__cta {
      order: 2;
      margin-left: auto;
      padding: 10px 14px;
      font-size: 11px;
      white-space: nowrap;
    }
    .nav__links {
      order: 3;
      flex-wrap: nowrap;
      gap: 14px;
      font-size: 14px;
      white-space: nowrap;
    }
    .nav__lang {
      order: 4;
      margin-left: auto;
    }
  }
</style>
