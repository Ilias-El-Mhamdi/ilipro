---
import type { Dictionary } from '../../i18n/ui';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const lastIndex = t.model.items.length - 1;
---

<section id="model" class="section model">
  <div class="container">
    <div class="model__head">
      <p class="eyebrow">[ {t.model.eyebrow} ]</p>
      <h2 class="h2">{t.model.titleStart} <span class="em">{t.model.titleEm}</span></h2>
    </div>
    <div class="model__grid">
      {
        t.model.items.map((item, i) => (
          <div class="model__item">
            <p class:list={['model__value', { 'model__value--em': i === lastIndex }]}>
              {item.value}
              {item.unit && <span class="model__unit">{item.unit}</span>}
            </p>
            <p class="model__label mono">{item.label}</p>
            <p class="model__text">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .model {
    background: var(--surface);
  }
  .model__head {
    text-align: center;
    margin-bottom: 80px;
  }
  .model__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .model__item {
    padding: 48px 40px;
  }
  .model__item + .model__item {
    border-left: 1px solid var(--line);
  }
  .model__value {
    font-size: clamp(48px, 5vw, 64px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 20px;
  }
  .model__value--em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--em);
  }
  .model__unit {
    font-size: 22px;
    letter-spacing: 0;
    color: var(--faint);
  }
  .model__label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .model__text {
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .model__item + .model__item {
      border-left: none;
      border-top: 1px solid var(--line);
    }
  }
</style>
