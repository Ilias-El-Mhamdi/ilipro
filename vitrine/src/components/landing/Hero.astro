---
import type { Dictionary } from '../../i18n/ui';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const tools = ['Salesforce', 'SharePoint', 'Excel', 'Outlook', 'Gmail'];
---

<section class="hero">
  <div class="container">
    <p class="eyebrow hero__eyebrow">[ {t.hero.eyebrow} ]</p>
    <h1 class="hero__title">
      {t.hero.titleStart} <span class="em">{t.hero.titleEm}</span>
    </h1>
    <p class="hero__lead">{t.hero.lead}</p>
    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">→ {t.hero.primary}</a>
      <a href="#cases" class="btn btn--ghost">→ {t.hero.secondary}</a>
    </div>
  </div>

  <div class="container hero__showcase">
    <figure class="demo">
      <figcaption class="demo__head mono">
        <span>{t.demo.label}</span>
        <span class="demo__status">● {t.demo.status}</span>
      </figcaption>
      <ol class="demo__steps">
        {
          t.demo.steps.map((step, i) => (
            <li class:list={['demo__step', { 'demo__step--last': i === t.demo.steps.length - 1 }]}>
              <span class="demo__index mono">{String(i + 1).padStart(2, '0')}</span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </figure>

    <div class="tools">
      <span class="tools__label mono">{t.demo.toolsLabel}</span>
      <ul class="tools__list">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(88px, 11vw, 136px) clamp(80px, 9vw, 112px);
  }
  .hero__eyebrow,
  .hero__title,
  .hero__lead {
    text-align: center;
  }
  .hero__eyebrow {
    margin-bottom: 32px;
  }
  .hero__title {
    font-size: clamp(42px, 6.4vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 980px;
    margin: 0 auto 32px;
  }
  /* La promesse (« Payés à la livraison. ») toujours sur sa propre ligne. */
  .hero__title .em {
    display: block;
    margin-top: 0.25em;
  }
  .hero__lead {
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto 48px;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: clamp(64px, 8vw, 96px);
  }

  .demo {
    margin: 0;
    background: var(--dark);
    color: var(--on-dark);
    border-radius: 6px;
    padding: clamp(28px, 4vw, 56px);
  }
  .demo__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 40px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dark-muted);
  }
  .demo__status {
    color: var(--accent-soft);
  }
  .demo__steps {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .demo__step {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border: 1px solid var(--dark-line);
    border-radius: 4px;
    font-size: 17px;
    line-height: 1.4;
  }
  .demo__step + .demo__step {
    margin-left: 48px;
    position: relative;
  }
  .demo__step + .demo__step::before {
    content: '';
    position: absolute;
    left: -49px;
    top: 50%;
    width: 48px;
    border-top: 1px dashed var(--dark-muted);
  }
  .demo__step--last {
    background: var(--bg);
    border-color: var(--bg);
    color: var(--ink);
  }
  .demo__index {
    font-size: 11px;
    color: var(--dark-muted);
  }
  .demo__step--last .demo__index {
    color: var(--em);
  }
  /* Mobile et tablette : la démo et les outils n'apportent rien, on enchaîne directement sur les cas d'usage. */
  @media (max-width: 1024px) {
    .hero__ctas {
      margin-bottom: 0;
    }
    .hero__showcase {
      display: none;
    }
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 56px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px dashed var(--line);
  }
  .tools__label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tools__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 56px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 20px;
    font-weight: 500;
    color: var(--faint);
  }
</style>
