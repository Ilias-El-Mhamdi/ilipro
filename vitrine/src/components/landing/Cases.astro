---
import { Image } from 'astro:assets';
import type { Dictionary } from '../../i18n/ui';
import prospection from '../../assets/cases/prospection.avif';
import routageLeads from '../../assets/cases/routage-leads.avif';
import reponseDevis from '../../assets/cases/reponse-devis.avif';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

// Une image par cas, dans l'ordre de t.cases.items (l'alt vit dans ui.ts).
const images = [reponseDevis, routageLeads, prospection];
---

<section id="cases" class="section section--dark">
  <div class="container">
    <div class="cases__head">
      <div>
        <p class="eyebrow">[ {t.cases.eyebrow} ]</p>
        <h2 class="h2 cases__title">{t.cases.titleStart} <span class="em">{t.cases.titleEm}</span></h2>
      </div>
      <p class="cases__lead">{t.cases.lead}</p>
    </div>
    <div class="cases__carousel" role="region" aria-roledescription="carousel" aria-label={t.cases.carouselLabel}>
      <button type="button" class="cases__arrow cases__arrow--prev" data-dir="-1" aria-label={t.cases.prev}>←</button>
      <button type="button" class="cases__arrow cases__arrow--next" data-dir="1" aria-label={t.cases.next}>→</button>
      <div class="cases__grid">
      {
        t.cases.items.map((item, i) => (
          <article class="case">
            <ul class="case__tags mono">
              {item.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <Image
              class="case__image"
              src={images[i]}
              alt={item.imageAlt}
              widths={[400, 800, 1200]}
              sizes="(max-width: 1100px) 100vw, 400px"
            />
            <div>
              <h3 class="case__title">{item.title}</h3>
              <p class="case__text">{item.text}</p>
            </div>
          </article>
        ))
      }
      </div>
    </div>
  </div>
</section>

<script>
  // Mobile : les flèches font défiler le carrousel d'une carte ; le swipe vient du scroll-snap natif.
  document.querySelectorAll<HTMLElement>('.cases__carousel').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.cases__grid');
    const arrows = carousel.querySelectorAll<HTMLButtonElement>('.cases__arrow');
    if (!track) return;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      arrows.forEach((arrow) => {
        arrow.disabled = arrow.dataset.dir === '-1' ? track.scrollLeft <= 0 : track.scrollLeft >= max;
      });
    };

    arrows.forEach((arrow) =>
      arrow.addEventListener('click', () => {
        track.scrollBy({ left: Number(arrow.dataset.dir) * track.clientWidth, behavior: 'smooth' });
      }),
    );
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .cases__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 64px;
  }
  .cases__title {
    max-width: 620px;
  }
  .cases__lead {
    max-width: 380px;
    color: var(--dark-muted);
  }
  .cases__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
  }
  .case {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 36px;
    background: var(--dark-card);
    border-radius: 6px;
  }
  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .case__tags li {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 9px;
    background: var(--dark-chip);
  }
  .case__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
  }
  .case__title {
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .case__text {
    font-size: 15px;
    color: var(--dark-muted);
  }
  .cases__carousel {
    position: relative;
  }
  .cases__arrow {
    display: none;
  }
  /* Mobile : « en production. » sur sa propre ligne, et les cas en carrousel (swipe + flèches). */
  @media (max-width: 640px) {
    .cases__title .em {
      display: block;
    }
    .cases__grid {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .cases__grid::-webkit-scrollbar {
      display: none;
    }
    .case {
      flex: 0 0 100%;
      scroll-snap-align: center;
      padding: 28px 24px;
    }
    .cases__arrow {
      display: grid;
      place-items: center;
      position: absolute;
      top: 50%;
      z-index: 1;
      width: 40px;
      height: 40px;
      margin-top: -20px;
      border: 1px solid var(--dark-line);
      border-radius: 50%;
      background: var(--on-dark);
      color: var(--ink);
      font-size: 18px;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }
    .cases__arrow--prev {
      left: -12px;
    }
    .cases__arrow--next {
      right: -12px;
    }
    .cases__arrow:disabled {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
