generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  projects  Project[]
  clients   ClientCompany[]
  licenses  License[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Project {
  id             String           @id @default(cuid())
  name           String
  slug           String
  appUrl         String?
  docsUrl        String?
  changelogUrl   String?
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  licenseProjects LicenseProject[]
  deliverables   Deliverable[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([companyId, slug])
}

model Client {
  id               String          @id @default(cuid())
  slug             String          @unique
  firstName        String
  lastName         String
  email            String          @unique
  companies        ClientCompany[]
  stripeCustomerId String?
  licenses         License[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ClientCompany {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  createdAt DateTime @default(now())

  @@unique([clientId, companyId])
}

enum LicenseType {
  CLASSIC
  FREE
  ADMIN
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model License {
  id                   String           @id @default(cuid())
  client               Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId             String
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId            String
  type                 LicenseType
  status               LicenseStatus

  projectAccess        LicenseProject[]

  machineLock          Boolean          @default(false)
  maxMachines          Int              @default(1)
  machines             LicenseMachine[]

  // CLASSIC — synced via Stripe webhooks
  stripeSubscriptionId String?
  stripeProductId      String?
  priceLabel           String?
  currentPeriodEnd     DateTime?

  // FREE — set manually by admin
  validUntil           DateTime?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([clientId, companyId])
}

model LicenseProject {
  id        String   @id @default(cuid())
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@unique([licenseId, projectId])
}

model LicenseMachine {
  id          String    @id @default(cuid())
  license     License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseId   String
  machineId   String
  label       String?
  activatedAt DateTime  @default(now())
  lastSeenAt  DateTime?

  @@unique([licenseId, machineId])
}

model Deliverable {
  id         String   @id @default(cuid())
  name       String
  url        String
  mimeType   String
  size       Int
  storageKey String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
